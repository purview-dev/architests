{
	"Build": {
		"Solution": "src/ArchitectureTesting.slnx",
		"TestRoot": "src",
		"TestPatterns": "*Tests.csproj",
		"TestFilter": "/*/*/*/*/"
	},
	"PackValidation": {
		"RequiredCompilerFlags": [
			"optimization=release"
		],
		"RequireSymbolPackage": true,
		"RequiredContent": {
			"purview.architecture.testing": [
				"README.md",
				"lib/$(TFM)/Purview.Architecture.Testing.dll",
				"lib/$(TFM)/Purview.Architecture.Testing.xml",
				"content/architecture-policy.schema.json",
				"purview-logo-light.png"
			],
			"purview.architecture.testing.cli": [
				"README.md",
				"purview-logo-light.png",
				"tools/net10.0/any/*"
			]
		}
	},
	"Release": {
		"Mode": "None"
	}
}
<Project>
	<PropertyGroup>
		<TUnitVersion>1.76.0</TUnitVersion>
		<JsonSchemaVersion>9.4.1</JsonSchemaVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
		<PackageVersion Include="JsonSchema.Net" Version="$(JsonSchemaVersion)" />
	</ItemGroup>
	<ItemGroup Label="Testing">
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Core" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Assertions" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<PackageVersion Include="Purview.Skills.Testing" Version="1.1.0" />
	</ItemGroup>
</Project>

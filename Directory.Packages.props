<Project>
	<PropertyGroup>
		<!-- Set explicitly rather than relying on auto-detection, so projects outside src/ (samples)
		     also use central package management. -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
		<TUnitVersion>1.75.0</TUnitVersion>
		<JsonSchemaVersion>9.4.1</JsonSchemaVersion>
	</PropertyGroup>
	<ItemGroup>
		<!-- SourceLink is auto-added by the SDK to IsPackable projects. -->
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
		<!-- Validates architecture-policy.json against the schema embedded in Purview.Architecture.Testing. -->
		<PackageVersion Include="JsonSchema.Net" Version="$(JsonSchemaVersion)" />
	</ItemGroup>
	<ItemGroup Label="Testing">
		<PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Core" Version="$(TUnitVersion)" />
		<PackageVersion Include="TUnit.Assertions" Version="$(TUnitVersion)" />
		<!-- Auto-added to test projects by the SDK. -->
		<PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
		<PackageVersion Include="Bogus" Version="35.6.5" />
		<!-- The Agent Skills conformance rule set, shipped by Purview.BuildSdk. -->
		<PackageVersion Include="Purview.Skills.Testing" Version="1.0.7" />
	</ItemGroup>
</Project>

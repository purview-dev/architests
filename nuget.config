<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<config>
		<add key="defaultPushSource" value="https://api.nuget.org/v3/index.json" />
	</config>
	<!--
		Deliberately additive. NuGet merges configuration hierarchically, so a feed defined in the
		machine or user NuGet.Config is also available here - which is what lets a sibling package
		built with `just pipeline-local-release` be consumed before it is published.

		No <clear /> and no <packageSourceMapping>: either one would exclude that local feed and
		break the local release workflow.

		Reproducibility is handled instead by the committed packages.lock.json files, which pin an
		exact version *and* a content hash per package. A restore in locked mode therefore fails if
		a package's content differs, whichever source served it - a stronger guarantee than
		restricting the source list.
	-->
	<packageSources>
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	</packageSources>
</configuration>
